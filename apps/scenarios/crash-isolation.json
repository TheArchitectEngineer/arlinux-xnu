{
  "id": "crash-isolation",
  "steps": [
    {
      "do": "launch",
      "app": "counter"
    },
    {
      "do": "see",
      "text": "Counter.*Count: ?0"
    },
    {
      "do": "launch",
      "app": "workers"
    },
    {
      "do": "see",
      "text": "Workers"
    },
    {
      "do": "crash",
      "app": "workers"
    },
    {
      "do": "alive",
      "app": "counter"
    },
    {
      "do": "focus",
      "app": "counter"
    },
    {
      "do": "click",
      "text": "^Increment$"
    },
    {
      "do": "see",
      "text": "Count: ?1"
    },
    {
      "do": "launch",
      "app": "workers"
    },
    {
      "do": "see",
      "text": "Workers"
    },
    {
      "do": "click",
      "text": "^Thread$"
    },
    {
      "do": "see",
      "text": "Thread: ?42"
    },
    {
      "do": "focus",
      "app": "counter"
    },
    {
      "do": "click",
      "text": "^Increment$"
    },
    {
      "do": "see",
      "text": "Count: ?2"
    },
    {
      "do": "focus",
      "app": "workers"
    },
    {
      "do": "close"
    },
    {
      "do": "exit",
      "app": "workers"
    },
    {
      "do": "focus",
      "app": "counter"
    },
    {
      "do": "close"
    },
    {
      "do": "exit",
      "app": "counter"
    }
  ]
}
