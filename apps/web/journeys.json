{
  "version": 1,
  "cases": [
    {
      "id": "dom-input",
      "steps": [
        {
          "do": "launch",
          "app": "web"
        },
        {
          "do": "see",
          "text": "WebCount: ?0",
          "timeoutSeconds": 45
        },
        {
          "do": "click",
          "text": "^Advance$"
        },
        {
          "do": "see",
          "text": "WebCount: ?1"
        },
        {
          "do": "close"
        },
        {
          "do": "exit",
          "app": "web"
        }
      ]
    }
  ]
}
