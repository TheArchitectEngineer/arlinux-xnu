# Failure-only console replay, explicitly distinct from its original attempt.
# App journeys inspect their original live process in ios-journeys.py instead.
settings set auto-confirm true
settings set target.disable-aslr false
script import importlib.util,sys; spec=importlib.util.spec_from_file_location("dyld_debugger","tools/dyld-debugger.py"); helper=importlib.util.module_from_spec(spec); sys.modules[spec.name]=helper; spec.loader.exec_module(helper)
target create build/native/macho-native
breakpoint set --name darwin_native_enter
process launch -i build/dyld/debugger.stdin -o build/dyld/debugger.stdout -e build/dyld/debugger.runtime.log -- --dyld build/ios-input/dyld --root build/ios-input/filesystem/root build/native/console-dynamic.macho
process handle -s false -n false -p true SIGSYS
script target=lldb.debugger.GetSelectedTarget(); process=target.GetProcess(); exception_bp=helper.install_exception_breakpoint(target)
breakpoint disable 1
script helper.resume_bounded(process)
process status
script stopped=process.GetState()==lldb.eStateStopped; print("REPLAY_GUEST_EXIT_STATUS",process.GetExitStatus()) if process.GetState()==lldb.eStateExited else None
script helper.capture_exception(process,exception_bp) if stopped else None
script lldb.debugger.HandleCommand("thread backtrace all --count 24") if stopped else None
script lldb.debugger.HandleCommand("register read") if stopped else None
script helper.capture_ipc_waits(process) if stopped else None
script lldb.debugger.HandleCommand("disassemble --frame --count 24") if stopped else None
script lldb.debugger.HandleCommand("process kill") if stopped else None
quit
