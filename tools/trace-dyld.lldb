# Runner-only dynamic diagnosis of the same failing application journey.
# SIGSYS is the runtime's transport and must reach its installed handler.
settings set auto-confirm true
settings set target.disable-aslr false
target create build/native/macho-native
breakpoint set --name darwin_native_enter
process launch -i build/dyld/debugger.stdin -o build/dyld/debugger.stdout -e build/dyld/debugger.runtime.log -- --dyld build/ios-input/dyld --root build/ios-input/filesystem/root build/native/console-dynamic.macho
process handle -s false -n false -p true SIGSYS

# The host entry stop occurs after Mach-O mappings exist, before guest code.
# Add the real Mach-O's symbols at the loader's declared slide.
script import os; target = lldb.debugger.GetSelectedTarget(); dyld_module = target.AddModule(os.path.abspath("build/ios-input/dyld"), "arm64-apple-ios", None); print("DYLD_SYMBOL_MODULE", dyld_module.IsValid()); assert dyld_module.IsValid(), "LLDB could not read the real Mach-O"
script load_error = target.SetModuleLoadAddress(dyld_module, 0x200000000); print(load_error); assert load_error.Success(), "Cannot relocate dyld symbols"
image list
register read pc sp x0 x1
thread backtrace all
disassemble --frame --count 10
breakpoint disable 1
script policy_bp = target.BreakpointCreateByName("amfi_check_dyld_policy_self"); print(policy_bp); assert policy_bp.GetNumResolvedLocations() > 0, "Policy breakpoint unresolved"
continue

# Require the expected breakpoint before stepping; a fatal BRK is not success.
script thread = target.GetProcess().GetSelectedThread(); assert thread.GetStopReason() == lldb.eStopReasonBreakpoint and thread.GetStopReasonDataAtIndex(0) == policy_bp.GetID(), "Unexpected stop before policy"
# Observe real policy input/output-pointer registers and step the actual code.
register read pc sp x0 x1
thread backtrace all
disassemble --frame --count 20
thread step-inst
register read pc sp x0 x1
breakpoint disable
# Observe the exact cache registration ABI, rather than guessing from source.
script cache_bp = target.BreakpointCreateByName("__fcntl"); print(cache_bp); assert cache_bp.GetNumResolvedLocations() > 0, "fcntl breakpoint unresolved"
continue
script process = target.GetProcess(); stopped = process.GetState() == lldb.eStateStopped; thread = process.GetSelectedThread(); cache_hit = stopped and thread.GetStopReason() == lldb.eStopReasonBreakpoint and thread.GetStopReasonDataAtIndex(0) == cache_bp.GetID(); print("CACHE_REGISTRATION_BREAKPOINT", cache_hit)
script lldb.debugger.HandleCommand("register read pc x0 x1 x2") if stopped else None
script lldb.debugger.HandleCommand("memory read --format x --size 8 --count 3 $x2") if cache_hit else None
script lldb.debugger.HandleCommand("thread backtrace all") if stopped else None
breakpoint disable
script lldb.debugger.HandleCommand("continue") if cache_hit else None

# A real program can report failure and exit normally. Preserve that result;
# only inspect registers/kill when a live process actually stopped on a fault.
process status
script stopped = process.GetState() == lldb.eStateStopped; print("GUEST_EXIT_STATUS", process.GetExitStatus()) if process.GetState() == lldb.eStateExited else None
script lldb.debugger.HandleCommand("thread backtrace all") if stopped else None
script lldb.debugger.HandleCommand("register read") if stopped else None
script lldb.debugger.HandleCommand("disassemble --frame --count 16") if stopped else None
script lldb.debugger.HandleCommand("process kill") if stopped else None
quit
